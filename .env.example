# ============================================================================
#  DisciplineOS — environment template.
#  Copy to .env (cp .env.example .env) and fill in. NEVER commit the real .env.
#  The same file is consumed by docker compose, the api container and the
#  backup scripts.
# ============================================================================

# ---------------------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------------------
# Public domain; Caddy requests a Let's Encrypt certificate for it automatically.
DOMAIN=dsos.example.com
# Contact address for Let's Encrypt expiry notices.
ACME_EMAIL=you@example.com
COMPOSE_PROJECT_NAME=disciplineos
# Image coordinates; CI overwrites these with the immutable sha tag.
API_IMAGE=ghcr.io/OWNER/disciplineos-api:latest
WEB_IMAGE=ghcr.io/OWNER/disciplineos-web:latest
VITE_APP_VERSION=prod

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
POSTGRES_USER=dsos
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=dsos
# Host "postgres" is the compose service name (only valid inside the compose network).
DATABASE_URL=postgresql+psycopg://dsos:change-me-to-a-long-random-password@postgres:5432/dsos

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
ENV=production                 # development | staging | production
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true
# 32+ random chars: openssl rand -hex 32
SECRET_KEY=change-me-openssl-rand-hex-32
# Simultaneously active devices per user (owner can override in Settings).
MAX_DEVICES_DEFAULT=2
# One-time pairing code lifetime.
PAIRING_CODE_TTL_MINUTES=15
# Optional: short window in which the SAME code may pair a second device
# (laptop + phone in one sitting). 0 disables it.
CROSS_DEVICE_PAIRING_CODE_TTL_MINUTES=0
# Prefix used for newly minted scoped API tokens, e.g. dsos_pat_live_XXXX
API_TOKEN_PREFIX=dsos_pat_
# Additional allowed origins for the API. Leave empty in production: the
# frontend is served from the same origin through Caddy.
# Example for local dev: http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGINS=
DEFAULT_TIMEZONE=Asia/Bangkok
# Rate limit (per IP, per minute) for pairing/refresh endpoints.
AUTH_RATE_LIMIT_PER_MINUTE=10

# ---------------------------------------------------------------------------
# Scheduler (APScheduler runs inside the api container)
# ---------------------------------------------------------------------------
SCHEDULER_ENABLED=true
# Cadence of the notification/housekeeping tick. Stage 7 fills this in.
HOUSEKEEPING_INTERVAL_MINUTES=15

# ---------------------------------------------------------------------------
# AI (stage 3): one provider, two models — strong vision + cheap text.
# AI_PROVIDER: openai | anthropic | google | openrouter | fake
# (fake = deterministic offline parser for tests and demos; never calls a network)
# ---------------------------------------------------------------------------
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=
AI_MODEL_VISION=gpt-4o
AI_MODEL_TEXT=gpt-4o-mini
# Soft cap of AI calls per day (all users). 0 = unlimited.
AI_DAILY_CALL_LIMIT=500
AI_TIMEOUT_SECONDS=60
# Per-user requests per minute on /ai/* (burst protection; the daily cap above is the budget).
AI_RATE_LIMIT_PER_MINUTE=6
# Upload bounds for meal photos (the app sends a ~1280 px JPEG).
AI_MAX_IMAGE_BYTES=3000000
AI_MAX_IMAGE_PX=2048
AI_MAX_TEXT_CHARS=1000
# Any request body above this is refused with 413 before it is parsed (photo + thumbnail fit).
MAX_REQUEST_BYTES=4000000
# The original photo is never stored. A 400 px thumbnail is kept only when the
# user enables "keep photo thumbnail"; unsaved thumbnails are deleted after:
AI_PENDING_THUMB_TTL_HOURS=24
# Audit payloads of AI calls (prompt/response JSON) are pruned after N days.
AI_JOB_PAYLOAD_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# Media (meal thumbnails). Mounted as the api_media volume in docker compose.
# ---------------------------------------------------------------------------
MEDIA_DIR=/data/media

# ---------------------------------------------------------------------------
# Open Food Facts live barcode fallback (stage 2b)
# A barcode that is not in the local library is looked up once on OFF; a
# product with complete nutriments and a ru/en name is cached as a library row.
# OFF asks API users to identify themselves with a descriptive User-Agent.
# ---------------------------------------------------------------------------
OFF_LIVE_LOOKUP=true
OFF_BASE_URL=https://world.openfoodfacts.org
OFF_TIMEOUT_SECONDS=6
OFF_USER_AGENT="DisciplineOS/0.1 (you@example.com)"
# Per-user live lookups per minute; misses are not re-asked for OFF_MISS_TTL_HOURS.
OFF_LOOKUPS_PER_MINUTE=20
OFF_MISS_TTL_HOURS=24

# ---------------------------------------------------------------------------
# Web push (stage 7) — generate with: python -m app.cli vapid-keys
# ---------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---------------------------------------------------------------------------
# Backups (nightly, encrypted with age, pushed to a private repo)
# ---------------------------------------------------------------------------
BACKUP_REPO=git@github.com:OWNER/dsos-backups.git
BACKUP_LOCAL_DIR=/var/backups/dsos
BACKUP_RETENTION_DAYS=14
# age public key (recipient). Private key stays outside the repo (see README).
AGE_RECIPIENT=age1change-me

# ---------------------------------------------------------------------------
# Frontend build-time variables (consumed by Vite in the web image build)
# ---------------------------------------------------------------------------
VITE_API_BASE=/api
