{
  "name": "disciplineos-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:only": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc -b --noEmit",
    "check:i18n": "node ../scripts/check-i18n.mjs",
    "gen:api": "openapi-typescript ${API_URL:-http://localhost:8000}/openapi.json -o src/api/generated/schema.d.ts",
    "lint": "tsc -b --noEmit"
  },
  "dependencies": {
    "@fontsource/rubik": "5.3.0",
    "@tanstack/react-query": "5.62.7",
    "@zxing/browser": "0.1.5",
    "@zxing/library": "0.21.3",
    "clsx": "2.1.1",
    "dexie": "4.0.10",
    "framer-motion": "11.15.0",
    "i18next": "23.16.8",
    "i18next-browser-languagedetector": "8.0.2",
    "qrcode.react": "4.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "15.2.0",
    "react-router-dom": "6.28.1",
    "recharts": "2.15.0",
    "tailwind-merge": "2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "axe-core": "4.14.0",
    "openapi-typescript": "7.5.2",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
    "vite": "5.4.11",
    "vite-plugin-pwa": "0.21.1"
  }
}
